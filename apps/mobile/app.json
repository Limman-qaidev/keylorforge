{
  "expo": {
    "name": "KeylorForge",
    "slug": "keylorforge",
    "version": "0.1.0",
    "scheme": "keylorforge",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "com.jonathansalgadonieto.keylorforge",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": false,
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ],
          "data": [
            {
              "scheme": "keylorforge",
              "host": "auth",
              "pathPrefix": "/confirm"
            },
            {
              "scheme": "keylorforge",
              "host": "auth",
              "pathPrefix": "/recovery"
            },
            {
              "scheme": "keylorforge",
              "host": "auth",
              "pathPrefix": "/oauth"
            }
          ]
        }
      ],
      "icon": "./assets/icons/keylorforge-app-icon.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icons/keylorforge-adaptive-foreground.png",
        "backgroundColor": "#075BFF",
        "monochromeImage": "./assets/icons/keylorforge-adaptive-monochrome.png"
      }
    },
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "icon": "./assets/icons/keylorforge-app-icon.png"
  }
}
