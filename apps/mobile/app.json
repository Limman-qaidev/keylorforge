{
  "expo": {
    "name": "KeylorFit",
    "slug": "keylorfit",
    "version": "0.1.0",
    "scheme": "keylorfit",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "com.jonathansalgadonieto.keylorfit",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": false,
          "category": ["BROWSABLE", "DEFAULT"],
          "data": [
            {
              "scheme": "keylorfit",
              "host": "auth",
              "pathPrefix": "/confirm"
            },
            {
              "scheme": "keylorfit",
              "host": "auth",
              "pathPrefix": "/recovery"
            }
          ]
        }
      ]
    },
    "plugins": ["expo-router"],
    "experiments": {
      "typedRoutes": true
    }
  }
}
