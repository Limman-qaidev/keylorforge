# Development-only FastAPI base URL for the iOS simulator. See README.md for
# Android emulator and physical-device LAN addresses.
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000

# Public Supabase client configuration for M1 Identity.
# These values are intentionally safe to ship in the mobile bundle.
# Do NOT place a Supabase secret/service-role key in any EXPO_PUBLIC_ variable.
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_<development-project-key>

# Public UI capability flags. Set to true only after the corresponding provider
# is configured in its provider console and in Supabase Auth. These are not
# security controls and contain no provider credentials.
EXPO_PUBLIC_GOOGLE_AUTH_ENABLED=false
EXPO_PUBLIC_APPLE_AUTH_ENABLED=false
