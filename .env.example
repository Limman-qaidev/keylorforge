# Local-only PostgreSQL defaults. These are intentionally non-production values.
# Copy to .env before starting Compose, then change the port only if 5432 is busy.
KEYLORFORGE_POSTGRES_USER=keylorforge
KEYLORFORGE_POSTGRES_PASSWORD=keylorforge_local_development_only
KEYLORFORGE_POSTGRES_DB=keylorforge
KEYLORFORGE_POSTGRES_TEST_DB=keylorforge_test
KEYLORFORGE_POSTGRES_PORT=5432
